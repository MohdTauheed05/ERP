# Database Configuration
# Local Windows / Development SQLite:
DATABASE_URL=sqlite:///./data/lubricants_erp.db

# Neon PostgreSQL (test database / Vercel)
# Create a Neon account, create a free Postgres project, then paste the pooled
# connection string into Vercel as the private DATABASE_URL environment variable.
# DB_ADAPTER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Any compatible PostgreSQL server: select DB_ADAPTER=postgres and set a server-only URL.
# DB_ADAPTER=postgres
# DATABASE_URL=postgresql://erp_user:CHANGE_ME@db.company.example:5432/lubricants_erp

# Storage & Backups
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MAX_UPLOAD_MB=25

# Security (Configure in environment / Settings -> Secrets; never commit secrets)
JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
ALLOW_NEGATIVE_STOCK=false

# Server Mode
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Frontend: set in Vercel to the deployed API origin (no trailing slash).
# Leave blank when frontend and API are served from the same origin.
VITE_API_BASE_URL=

# API: comma-separated browser origins permitted to call this server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

