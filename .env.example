# Database Configuration
# Local Windows / Development SQLite:
DATABASE_URL=sqlite:///./data/lubricants_erp.db

# Firebase SQL Connect / Cloud SQL PostgreSQL (Vercel)
# DB_ADAPTER=cloudsql
# CLOUD_SQL_CONNECTION_NAME=petroblend-erp:me-west1:petroblend-erp-instance
# PGDATABASE=postgres
# GCP_PROJECT_NUMBER=408034291620
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-erp
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-erp
# GCP_SERVICE_ACCOUNT_EMAIL=vercel-erp@petroblend-erp.iam.gserviceaccount.com

# Future company PostgreSQL server: select DB_ADAPTER=postgres and set a server-only URL.
# DB_ADAPTER=postgres
# DATABASE_URL=postgresql://erp_user:CHANGE_ME@db.company.example:5432/lubricants_erp

# Storage & Backups
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MAX_UPLOAD_MB=25

# Security (Configure in environment / Settings -> Secrets; never commit secrets)
JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
ALLOW_NEGATIVE_STOCK=false

# Server Mode
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Frontend: set in Vercel to the deployed API origin (no trailing slash).
# Leave blank when frontend and API are served from the same origin.
VITE_API_BASE_URL=

# API: comma-separated browser origins permitted to call this server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
